#!/usr/bin/env bash
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# Allow skipping (e.g., SKIP_HOOKS=1 git commit ...)
if [[ "${SKIP_HOOKS:-}" == "1" ]]; then
  echo -e "${YELLOW}⏭  Pre-commit hooks skipped via SKIP_HOOKS=1${NC}"
  exit 0
fi

echo -e "${YELLOW}⏳ Running formatter (imports + fixes + format)...${NC}"
if ! tool/format.sh; then
  echo -e "${RED}❌ Formatting failed. Please fix and try again.${NC}"
  exit 1
fi

# Restage any changes done by formatter
git add -A

# Never commit secrets in the debug env map. If the working tree is filled
# (normal after `dart run tool/sync_dev_env.dart`), stage an empty version and
# restore local values so bare `flutter run` still works.
DEV_ENV_G="lib/core/config/dev_env.g.dart"
if [[ -f "$DEV_ENV_G" ]] && ! dart run tool/sync_dev_env.dart --check-clean >/dev/null 2>&1; then
  echo -e "${YELLOW}🔐 Staging empty $DEV_ENV_G (keeping local secrets unstaged)...${NC}"
  LOCAL_COPY="$(mktemp -t dev_env_g.XXXXXX.dart)"
  cp "$DEV_ENV_G" "$LOCAL_COPY"
  dart run tool/sync_dev_env.dart --empty >/dev/null
  git add "$DEV_ENV_G"
  cp "$LOCAL_COPY" "$DEV_ENV_G"
  rm -f "$LOCAL_COPY"
fi

echo -e "${YELLOW}🔍 Running analyzer (will block only on errors)...${NC}"
TMP_REPORT=$(mktemp -t analyze.XXXXXX)

# Prefer repo-local Flutter SDK for analyzer
if [[ -x ".fvm/flutter_sdk/bin/flutter" ]]; then
  FLT=".fvm/flutter_sdk/bin/flutter"
elif command -v flutter >/dev/null 2>&1; then
  FLT="$(command -v flutter)"
else
  FLT="flutter" # best-effort fallback
fi

if "$FLT" analyze >"$TMP_REPORT" 2>&1; then
  echo -e "${GREEN}✅ No analyzer issues found.${NC}"
  rm -f "$TMP_REPORT"
  exit 0
fi

# Check if there are errors (not just warnings/infos)
if grep -q "error •" "$TMP_REPORT"; then
  echo -e "${RED}❌ Analyzer errors detected. Commit aborted.${NC}"
  cat "$TMP_REPORT"
  rm -f "$TMP_REPORT"
  exit 1
else
  echo -e "${YELLOW}⚠️  Analyzer reported warnings/infos, proceeding with commit.${NC}"
  cat "$TMP_REPORT"
  rm -f "$TMP_REPORT"
  exit 0
fi
